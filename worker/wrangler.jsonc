// Blundr on Cloudflare: one Worker serving the static site (web-dist/, built by scripts/build_web.py) and the
// optional accounts under /account/* with their D1 database. docs/accounts.md has the set-up steps.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blundr",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../web-dist",
    "binding": "ASSETS",
    // only the account API reaches the Worker's code; every other request is a static file, free and unmetered
    "run_worker_first": ["/account/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blundr",
      // `wrangler d1 create blundr --jurisdiction eu` prints the real id; this one only works locally. The EU
      // jurisdiction is what lets privacy.html say the database stays in the EU.
      "database_id": "63f34fde-53a2-4b4e-b405-54a461df94da",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Lichess needs no registration: the client id is any name the sign-in page shows you
    "LICHESS_CLIENT_ID": "blundr.gr",
    // accounts unused this long are deleted with their data (the privacy policy says so)
    "RETENTION_DAYS": "730",
    // sign-up and password-reset codes come from here; blundr.gr must be an authenticated domain at Brevo
    "MAIL_FROM": "Blundr <login@blundr.gr>"
    // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and BREVO_API_KEY are secrets: `wrangler secret put`, or .dev.vars
    // locally. Without Google's the Google button is hidden; without BREVO_API_KEY (as under `wrangler dev`) nothing
    // is sent and the message is printed in the console. Cloudflare's own Email Sending (a "send_email" binding named
    // EMAIL) is used instead when there is no Brevo key, but it needs the Workers Paid plan.
  },
  // once a day: expired sessions, abandoned sign-ins, and accounts past RETENTION_DAYS
  "triggers": { "crons": ["17 3 * * *"] },
  // Cloudflare's request logs would hold IP addresses; the privacy policy says none are kept
  "observability": { "enabled": false }
}
