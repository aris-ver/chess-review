# systemd unit for the review server inside WSL. Install once:
#   sudo cp deploy/chess-review.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now chess-review
# Logs: journalctl -u chess-review -f
[Unit]
Description=chess-review server (static site + on-demand Stockfish analysis)
After=network-online.target

[Service]
User=aris
WorkingDirectory=/home/aris/projects/chess-review
ExecStart=/home/aris/projects/chess-review/.venv/bin/python -m chess_review serve --host 0.0.0.0 --port 8123
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
